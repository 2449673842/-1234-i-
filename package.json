{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:behavior-smoke": "node tests/playwright/scifigure_behavior_smoke.mjs",
    "test:semantic-smoke": "node tests/playwright/semantic_centers_smoke.mjs",
    "test:multisubplot-smoke": "node tests/playwright/multisubplot_semantics_smoke.mjs",
    "test:cross-figure-smoke": "node tests/playwright/cross_figure_apply_smoke.mjs",
    "test:drag-extended-smoke": "node tests/playwright/drag_extended_smoke.mjs",
    "test:export-matrix-smoke": "node tests/playwright/export_matrix_smoke.mjs",
    "test:r-semantic-smoke": "node tests/playwright/r_semantic_centers_smoke.mjs",
    "test:cache-smoke": "node tests/api/render_cache_smoke.mjs",
    "test:component-kind-matrix": "node tests/api/component_kind_matrix_smoke.mjs",
    "test:cross-figure-concurrency": "node tests/api/cross_figure_concurrency_smoke.mjs",
    "test:composer-smoke": "node tests/api/composer_consistency_smoke.mjs",
    "test:composer-stale-smoke": "node tests/playwright/composer_stale_ui_smoke.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/archiver": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "papaparse": "^5.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  }
}
