map $http_upgrade $scifigure_connection_upgrade {
    default upgrade;
    '' close;
}

limit_req_zone $binary_remote_addr zone=scifigure_per_ip:10m rate=15r/s;
limit_conn_zone $binary_remote_addr zone=scifigure_connections:10m;

upstream scifigure_active {
    server 127.0.0.1:3101;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;
    client_max_body_size 64m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 60s;
    limit_req_status 429;
    limit_conn_status 429;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/scifigure-acme;
    }

    location = /server.cjs {
        return 404;
    }

    location = /server.cjs.map {
        return 404;
    }

    location / {
        limit_req zone=scifigure_per_ip burst=60 nodelay;
        limit_conn scifigure_connections 20;
        proxy_pass http://scifigure_active;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $scifigure_connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 240s;
        proxy_read_timeout 240s;
        proxy_buffering off;
    }
}
