NODE_ENV=production
SCIFIGURE_BIND_HOST=127.0.0.1
SCIFIGURE_DATA_DIR=/srv/scifigure/data
SCIFIGURE_DB_PATH=/srv/scifigure/data/scifigure.db
SCIFIGURE_RENDER_MODE=docker
SCIFIGURE_ALLOW_UNSAFE_LOCAL_RENDERER=0
SCIFIGURE_RENDER_MEMORY=896m
SCIFIGURE_RENDER_CPUS=1
SCIFIGURE_RENDER_PIDS=96
SCIFIGURE_RENDER_CONCURRENCY=1
SCIFIGURE_RENDER_OUTPUT_MB=8
SCIFIGURE_R_TIMEOUT_MS=90000
SCIFIGURE_TABULAR_TIMEOUT_MS=60000
SCIFIGURE_TABULAR_OUTPUT_MB=24
SCIFIGURE_TABULAR_MEMORY=512m
SCIFIGURE_TABULAR_CPUS=0.5
SCIFIGURE_TABULAR_PIDS=64
SCIFIGURE_TABULAR_CONCURRENCY=1
SCIFIGURE_GRACEFUL_SHUTDOWN_MS=180000
SCIFIGURE_ACCESS_TOKEN_MINUTES=15
SCIFIGURE_REFRESH_TOKEN_DAYS=30
SCIFIGURE_R_RISK_ENFORCE=0
SCIFIGURE_LEGACY_RETIRE_OBSERVABILITY=1
SCIFIGURE_LEGACY_RETIRE_OBSERVATION_DIR=/var/lib/scifigure/observability
DOCKER_HOST=unix:///run/user/__SCIFIGURE_UID__/docker.sock
XDG_RUNTIME_DIR=/run/user/__SCIFIGURE_UID__
TMPDIR=/var/lib/scifigure/runtime
TMP=/var/lib/scifigure/runtime
TEMP=/var/lib/scifigure/runtime
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
