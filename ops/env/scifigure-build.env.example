# Domestic-first mirrors for repeatable release builds. Keep this file root-owned
# and not group/world-writable because deploy-release.sh parses it as root.
SCIFIGURE_NPM_REGISTRY=https://registry.npmmirror.com
SCIFIGURE_RENDERER_DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
SCIFIGURE_RENDERER_DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
SCIFIGURE_RENDERER_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
SCIFIGURE_UBUNTU_APT_MIRROR=https://mirrors.aliyun.com/ubuntu
SCIFIGURE_DOCKER_APT_BASE_URL=https://mirrors.aliyun.com/docker-ce
SCIFIGURE_DOCKER_REGISTRY_MIRROR=https://docker.m.daocloud.io
