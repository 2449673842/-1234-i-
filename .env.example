# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PYTHON_BIN: Optional. Absolute path to the Python executable used by the
# renderer. Set this when the system PATH points to a different Python than
# the one where matplotlib/pandas/scipy/seaborn are installed.
# Example Windows Store Python:
# PYTHON_BIN="C:\\Users\\SZC\\AppData\\Local\\Microsoft\\WindowsApps\\PythonSoftwareFoundation.Python.3.12_qbz5n2kfra8p0\\python.exe"

# RSCRIPT_BIN: Optional. Absolute path to Rscript for R rendering support.
# Example Conda R installation:
# RSCRIPT_BIN="C:\\Users\\SZC\\.conda\\envs\\Machine-learning\\Scripts\\Rscript.exe"

# Rendering isolation. Build Dockerfile.renderer on the host or a dedicated
# renderer worker. Do not mount /var/run/docker.sock into the public Web container.
# Production defaults to docker; local development can explicitly use local.
SCIFIGURE_RENDER_MODE="docker"
SCIFIGURE_RENDERER_IMAGE="scifigure-renderer:latest"
# Bind production instances to loopback and expose them only through Nginx.
# Keep 0.0.0.0 for local development when direct LAN access is intentional.
SCIFIGURE_BIND_HOST="127.0.0.1"
SCIFIGURE_RENDER_MEMORY="1g"
SCIFIGURE_RENDER_CPUS="1"
SCIFIGURE_RENDER_PIDS="128"
SCIFIGURE_RENDER_CONCURRENCY="4"
SCIFIGURE_RENDER_OUTPUT_MB="8"
SCIFIGURE_R_TIMEOUT_MS="45000"
SCIFIGURE_GRACEFUL_SHUTDOWN_MS="180000"
# Emergency development-only override for non-development environments.
# Never enable this on a public server.
SCIFIGURE_ALLOW_UNSAFE_LOCAL_RENDERER="0"

# Isolated XLS/XLSX parser limits. Production uses the renderer Docker image;
# development uses a separate local Python process for compatibility.
SCIFIGURE_TABULAR_TIMEOUT_MS="30000"
SCIFIGURE_TABULAR_OUTPUT_MB="24"
SCIFIGURE_TABULAR_MEMORY="512m"
SCIFIGURE_TABULAR_CPUS="0.5"
SCIFIGURE_TABULAR_PIDS="64"
SCIFIGURE_TABULAR_CONCURRENCY="2"

# R risk precheck is log-only by default. Set to 1 in production after
# compatibility review to block critical/high-risk process, network, dynamic
# loading and concrete dangerous capability calls before execution. Merely
# loading a capability package remains warning-only for compatibility.
SCIFIGURE_R_RISK_ENFORCE="0"

# Access tokens expire quickly; refresh sessions are stored in an HttpOnly cookie.
SCIFIGURE_ACCESS_TOKEN_MINUTES="15"
SCIFIGURE_REFRESH_TOKEN_DAYS="30"
ADMIN_RATE_LIMIT_PER_15_MINUTES="60"

# Additive editor capability rollout. Keep both disabled by default in
# production until the corresponding fixed-fixture/browser matrix passes.
# Shadow diagnostics record target metadata only, never operation values.
VITE_SCIFIGURE_TARGET_RESOLVER_SHADOW="0"
# First controlled migration: Font Center only. Legacy manifests without the
# v1.1 identity/capability fields automatically use the existing compiler.
VITE_SCIFIGURE_FONT_TARGET_RESOLVER_V2="0"
# Second controlled migration: only axis frames, grids, data lines and legend
# markers in Component Center. Other component categories remain on v1.
VITE_SCIFIGURE_COMPONENT_TARGET_RESOLVER_V2="0"
# Third controlled migration: Palette Center uses per-target binding metadata
# and refuses ambiguous same-color fan-out. Python code constants remain scoped
# by target_id; R and selected-only edits require resolved object targets.
VITE_SCIFIGURE_PALETTE_TARGET_RESOLVER_V2="0"

# Administrator access is database-role based. Do not expose an admin-secret
# HTTP header. Provision or revoke a role from the server console:
# npm run security:set-user-role -- --email admin@example.com --role admin

# Production data protection is intentionally transparent to the application.
# Mount ./data from an encrypted cloud disk or encrypted host volume, then back
# it up with restic to an encrypted remote repository. Do not commit these values.
# Optional data root. Defaults to ./data. Tests and production deployments can
# isolate the database, project files and exports without changing application code.
# SCIFIGURE_DATA_DIR="/srv/scifigure/data"
# RESTIC_REPOSITORY="s3:s3.example.com/scifigure-backups/production"
# RESTIC_PASSWORD_FILE="/etc/scifigure/restic-password"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# Explicit owner for one-time adoption of legacy rows that have no user_id.
# Never infer this from account creation order; test accounts may be created first.
SCIFIGURE_LEGACY_OWNER_EMAIL=

# Legacy retirement observation. Enable only for an authenticated release
# observation window. Keep anonymized JSONL outside the user data directory.
SCIFIGURE_LEGACY_RETIRE_OBSERVABILITY="0"
SCIFIGURE_LEGACY_RETIRE_OBSERVATION_DIR="/var/lib/scifigure/observability"
SCIFIGURE_BUILD_ID="replace-with-immutable-release-id"
